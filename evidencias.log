$ declare -f sample
sample () 
{ 
    n=$1;
    p=0;
    f=0;
    for i in $(seq 1 $n);
    do
        rm -f tests/threads/alarm-priority.output tests/threads/alarm-priority.result;
        r=$(make tests/threads/alarm-priority.result 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E '^(pass|FAIL)');
        case "$r" in 
            pass*)
                p=$((p+1))
            ;;
            *)
                f=$((f+1));
                echo "  execucao $i: $r"
            ;;
        esac;
    done;
    echo "alarm-priority: pass=$p fail=$f (de $n)"
}

